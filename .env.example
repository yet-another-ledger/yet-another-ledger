# Copy this file to .env and adjust for local development.
# Docker Compose reads .env automatically for variable interpolation.
# .env is gitignored; .env.example is committed as a template.

# --- PostgreSQL ---
# Bootstrap admin is used only by the PostgreSQL image during first creation.
# Migrations own schema changes; the running web process uses the distinct,
# non-superuser runtime role below. Change all defaults before deployment.
POSTGRES_ADMIN_USER=jai_admin
POSTGRES_ADMIN_PASSWORD=jai_admin
POSTGRES_MIGRATION_USER=jai_migrator
POSTGRES_MIGRATION_PASSWORD=jai_migrator
POSTGRES_APP_USER=jai_app
POSTGRES_APP_PASSWORD=jai_app
POSTGRES_DB=jai

# Host and port the backend uses to connect to PostgreSQL.
# - Local dev:  localhost + the host-mapped port (see docker-compose.dev.yml).
# - Production: container name (e.g. postgres) + 5432 (default).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Host backend defaults to the runtime app role above. Host Alembic safely
# assembles its migration-owner URL from the fields above.
# DATABASE_MIGRATION_URL can override that independently; a legacy
# DATABASE_URL-only Alembic command remains accepted for compatibility. The
# runtime default deliberately has no DDL permission.

# Optional full connection-string overrides. DATABASE_URL is the runtime URL.
# For external PostgreSQL set all three URLs. DATABASE_MIGRATION_URL wins in
# db-migration; DATABASE_URL remains its legacy fallback. Compose otherwise
# passes raw role fields and the app/Alembic/psql construct connections safely.
# Runtime must remain NOSUPERUSER/NOBYPASSRLS.
# DATABASE_URL=postgresql+asyncpg://jai_app:...@db.example/jai
# DATABASE_MIGRATION_URL=postgresql+asyncpg://jai_migrator:...@db.example/jai
# DATABASE_PROVISION_URL=postgresql://jai_admin:...@db.example/jai
#
# Existing pre-M12 volumes created with POSTGRES_USER=jai upgrade automatically
# if the old values remain available. If renamed, set these only for transition:
# POSTGRES_LEGACY_USER=jai
# POSTGRES_LEGACY_PASSWORD=jai

# --- App ---
# The backend always listens on 8000 in local development and inside Docker.
# Docker Compose publishes the app container only on loopback for a reverse
# proxy; change this host-side port when 8000 is already taken.
APP_HOST_PORT=8000

# Version shown in /api/health response.
APP_VERSION=0.9.0

# Path to frontend build output (used in deployment mode to serve SPA).
# Leave empty or unset for backend-only development.
# STATIC_DIR=/app/static

# --- Authentication ---
# JWT signing secret. Leave unset for self-hosting: the app auto-generates a
# random secret on first boot and persists it in the database (unique per
# deployment). Only set this to pin an externally managed secret.
# AUTH_SECRET=
# Cookies are HTTPS-only when true. Compose defaults this to true (production
# behind a TLS reverse proxy); set false for local dev or plain-HTTP access.
COOKIE_SECURE=false

# --- Email (base URL) ---
# Public-facing URL of the app, used to generate absolute links in emails
# (e.g. password reset).  Must be set to the real domain in production.
# Leave unset for local dev (defaults to http://localhost:8000).
# BASE_URL=https://invoice.example.com
